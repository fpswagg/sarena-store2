# The SSS business shown by this site.
SSS_STORE_SLUG=sarena
# SSS API, reachable from the visitor's browser (sign-in, assistant).
SSS_API_URL=https://sss-api.fpswagg.site
# Seconds before SSS data is fetched again.
SSS_REVALIDATE=300
# POST /api/revalidate?secret=… clears the cache.
REVALIDATE_SECRET=
# Public address of this site, without a trailing slash. Change it when the domain changes.
SITE_URL=https://sarena.fpswagg.site
# Sign in with SSS, for /dashboard (SSS > Business > API > Sign in with SSS).
# Redirect URL: {SITE_URL}/auth/sss/callback
SSS_OAUTH_CLIENT_ID=
SSS_OAUTH_CLIENT_SECRET=
# Encrypts the dashboard session cookie (32 characters minimum).
SESSION_SECRET=
# Optional: overrides the assistant key published by SSS.
SSS_BOT_KEY=
